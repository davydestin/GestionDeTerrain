APP_NAME=GestionDeTerrain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Connexion des clients avec Google : « ID client OAuth » (type Application Web) de la Google Cloud Console.
# Doit être identique à VITE_GOOGLE_CLIENT_ID côté frontend.
GOOGLE_CLIENT_ID=
DAKAR_SOUTH_BOUND=14.55
DAKAR_NORTH_BOUND=14.85
DAKAR_WEST_BOUND=-17.55
DAKAR_EAST_BOUND=-17.10

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Un fichier par jour (storage/logs/laravel-AAAA-MM-JJ.log), conservé LOG_DAILY_DAYS jours,
# consultable par l'administrateur (page « Logs »). En production : LOG_LEVEL=warning.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestiondeterrain
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Mettre un contact réel en production ; Nominatim refuse (403) les adresses example.com.
NOMINATIM_USER_AGENT="GestionDeTerrain/1.0"
NOMINATIM_EMAIL=
NOMINATIM_CACHE_MINUTES=1440
# Sous Windows, renseigner le chemin vers un bundle CA valide si PHP n'en fournit pas.
NOMINATIM_CA_BUNDLE=

# Compte administrateur créé par `php artisan migrate --seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!
